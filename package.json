{
  "name": "hexa-game",
  "version": "1.3.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "eas:development": "npx eas-cli build --profile development",
    "eas:production": "npx eas-cli build --profile production",
    "eas:android": "npx eas-cli build --platform android --profile production",
    "eas:ios": "npx eas-cli build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.15",
    "typescript": "~6.0.3"
  }
}
